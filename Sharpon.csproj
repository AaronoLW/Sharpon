<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
  	<PublishDir>publish</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiscordRPC" Version="1.0.0" />
    <PackageReference Include="Ghostflyby.Pty" Version="1.0.1" />
    <PackageReference Include="SmashFramework" Version="2.2.0" />
    <PackageReference Include="KatziDrip" Version="1.1.0" />
    <PackageReference Include="XTerm.NET" Version="3.0.2" />
  </ItemGroup>

  <PropertyGroup>
      <IncludeAssets Condition="'$(IncludeAssets)' == ''">false</IncludeAssets>
  </PropertyGroup>

  <ItemGroup Condition="'$(IncludeAssets)' == 'true'">
      <EmbeddedResource Include="Assets/**/*" />
  </ItemGroup>

</Project>
