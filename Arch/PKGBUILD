pkgname=Sharpon-git
pkgver=7
pkgrel=1
pkgdesc="Peak description"
arch=('x86_64')
url="https://github.com/AaronoLW/Sharpon"
license=('MIT')
depends=('ttf-iosevka' 'sdl3' 'sdl3_image' 'sdl3_ttf' 'fontconfig')
makedepends=('dotnet-sdk' 'git')
source=("git+$url.git")
sha256sums=('SKIP')

build() {
    cd "$srcdir/Sharpon"

    dotnet restore --locked-mode
    dotnet publish -c Release
}

package() {
    install -Dm755 "$srcdir/Sharpon/publish/Sharpon" \
        "$pkgdir/usr/bin/Sharpon"

    install -Dm644 "$srcdir/Sharpon/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    install -Dm644 "$srcdir/Sharpon/Sharpon.desktop" \
            "$pkgdir/usr/share/applications/Sharpon.desktop"

    install -Dm644 "$srcdir/Sharpon/Sharpon.png" \
            "$pkgdir/usr/share/icons/hicolor/256x256/apps/Sharpon.png"
}
